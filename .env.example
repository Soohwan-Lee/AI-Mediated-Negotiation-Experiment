# LLM. Without a key, AI turns fall back to canned text so the flow is walkable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Developer / mockup panel. Present by default everywhere, including deployed
# builds, so the layout can be walked without reconfiguring anything.
#
# SET THIS TO "off" AND REDEPLOY BEFORE RECRUITING. The panel names conditions
# and shows the assignment; the in-panel toggle is per-browser and does not
# hide it from participants. This variable does.
# NEXT_PUBLIC_DEV_TOOLS=off

# Supabase (planned — not yet wired; see docs/DATA_MODEL.md)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
