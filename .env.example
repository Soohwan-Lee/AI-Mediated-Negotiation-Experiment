# LLM. Without a key, AI turns fall back to canned text so the flow is walkable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Developer / mockup panel. Present by default everywhere, including deployed
# builds, so the layout can be walked without reconfiguring anything.
#
# SET THIS TO "off" AND REDEPLOY BEFORE RECRUITING. The panel names conditions
# and shows the assignment; the in-panel toggle is per-browser and does not
# hide it from participants. This variable does.
# NEXT_PUBLIC_DEV_TOOLS=off

# Research server storage. Required when NEXT_PUBLIC_DEV_TOOLS=off.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=                  # new sb_secret_ key, server only
# Or use the legacy server service-role JWT instead:
# SUPABASE_SERVICE_ROLE_KEY=
# Optional separate signing secret. Otherwise cookie HMAC uses the server key
# with a study-specific prefix. Never use NEXT_PUBLIC_ for either secret.
# STUDY_SESSION_SECRET=
# Optional token for the detailed launch report (public ?gate=1 reveals only ready).
# PREFLIGHT_TOKEN=
